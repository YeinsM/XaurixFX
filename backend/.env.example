# Local PostgreSQL started by `docker compose up -d --wait postgres`.
DATABASE_URL=postgresql://xaurix:xaurix_local_only@127.0.0.1:55440/xaurix
FRONTEND_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=4000
NODE_ENV=development
# Required for generation; set only in ignored backend/.env and never commit the secret.
GEMINI_API_KEY=
# Optional; defaults to gemini-4-hydrogen.
GEMINI_MODEL=gemini-4-hydrogen
# Optional: absolute path to Python with Argos Translate and the en→es model installed.
# NEWS_TRANSLATOR_PYTHON=C:\path\to\translate-venv\Scripts\python.exe
# Use a disposable database; tests create and remove their own random schema.
TEST_DATABASE_URL=postgresql://xaurix:xaurix_local_only@127.0.0.1:55440/xaurix_test


# IDs de cuentas existentes que pueden generar análisis; vacío = nadie.
ANALYSIS_ADMIN_USER_IDS=
# Modelo de Gemini para las imágenes de los escenarios A y B (opcional).
GEMINI_IMAGE_MODEL=gemini-3-pro-image
# Carpeta local de imágenes; luego se puede sustituir por almacenamiento en la nube.
ANALYSIS_IMAGE_DIR=storage/analysis-images
